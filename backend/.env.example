APP_ENV=development
APP_NAME=ChanaX API
API_V1_PREFIX=/api/v1
FRONTEND_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ACCOUNT_DELETION_CRON_SECRET=
# Comma-separated Supabase Auth user UUIDs. Never expose this in Vite.
PLATFORM_ADMIN_USER_IDS=

SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=ChanaX
SMTP_USE_TLS=true

# Razorpay Test Mode credentials. Never expose the secret values to Vite.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_MODE=test

WHITEBOOKS_BASE_URL=https://api.whitebooks.in
WHITEBOOKS_CLIENT_ID=
WHITEBOOKS_CLIENT_SECRET=
WHITEBOOKS_EMAIL=
WHITEBOOKS_GSTIN_PATH=/public/search
WHITEBOOKS_TIMEOUT_SECONDS=20

REDIS_URL=redis://redis:6379/0
