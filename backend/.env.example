REDIS_URL=redis://redis:6379/0

# n8n webhook that sends invoice/quotation PDFs through the ChanaX WhatsApp number.
# Leave the URL empty to disable "Send on WhatsApp". The secret is optional; when
# set it is sent as the X-ChanaX-Secret header so n8n can reject other callers.
N8N_WHATSAPP_WEBHOOK_URL=
N8N_WHATSAPP_SECRET=
