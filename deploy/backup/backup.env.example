# Copy to /opt/chanax/backup.env on the VPS and chmod 600. Never commit the real file.

# Supabase > Connect > "Session pooler" connection string, using the database password.
# (A dedicated read-only role is better than the postgres superuser.)
SUPABASE_DB_URL=

# Where backups are kept on this server, and for how many days.
BACKUP_DIR=/var/backups/chanax
RETENTION_DAYS=14

# Encrypt every backup file with age. Recommended: set to your PUBLIC key (age1...).
# Keep the matching private key somewhere safe and off this server, or you cannot restore.
BACKUP_AGE_RECIPIENT=

# Copy each backup off the server (a backup on the same server is lost with the server).
# An rclone remote, e.g. "b2:chanax-backups" or "gdrive:chanax-backups".
RCLONE_REMOTE=

# Folder holding n8n's data (workflows and credentials). Leave empty if n8n is backed up elsewhere.
N8N_DATA_DIR=

# Pings this URL when a backup starts, finishes and fails (healthchecks.io or similar), so you
# are told when a backup did NOT run. Leave empty to disable.
HEALTHCHECK_URL=
