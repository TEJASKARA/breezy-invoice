    {
      "parameters": {
        "sendTo": "={{ $json.email }}",
        "subject": "=Simplify your business operations with Chanax",
        "message": "=<div style=\"font-family: Arial, Helvetica, sans-serif; max-width: 600px; margin: 0 auto; color: #333333; line-height: 1.6;\">\n\n  <p style=\"font-size: 16px;\">\n    Hi {{ $json.name }},\n  </p>\n\n  <p style=\"font-size: 16px;\">\n    What if your invoices, quotations, employee records, attendance, and expenses\n    could all be managed from one simple workspace?\n  </p>\n\n  <p style=\"font-size: 16px;\">\n    <strong>That's ChanaX.</strong>\n  </p>\n\n  <p style=\"font-size: 16px;\">\n    One workspace. Less paperwork. Less switching between tools.\n  </p>\n\n  <div style=\"background-color: #f7f8fa; padding: 20px; border-radius: 8px; margin: 20px 0;\">\n    <p style=\"margin-top: 0; font-size: 16px;\">\n      With ChanaX, you can:\n    </p>\n\n    <p style=\"font-size: 15px; margin: 8px 0;\">\n      ✓ Create invoices and quotations\n    </p>\n\n    <p style=\"font-size: 15px; margin: 8px 0;\">\n      ✓ Manage employee records\n    </p>\n\n    <p style=\"font-size: 15px; margin: 8px 0;\">\n      ✓ Track attendance and expenses\n    </p>\n\n    <p style=\"font-size: 15px; margin: 8px 0;\">\n      ✓ Export your business data whenever you need it\n    </p>\n  </div>\n\n  <p style=\"font-size: 16px;\">\n    No complicated ERP. Just the essentials you need to run your business.\n  </p>\n\n  <div style=\"margin: 30px 0;\">\n    <a href=\"https://chanax.in\"\n       style=\"background-color: #2563eb; color: #ffffff; text-decoration: none;\n              padding: 12px 24px; border-radius: 6px; display: inline-block;\n              font-size: 15px; font-weight: bold;\">\n      Try ChanaX For Free →\n    </a>\n  </div>\n\n  <p style=\"font-size: 15px;\">\n    See how simple business management can be.\n  </p>\n\n  <p style=\"font-size: 15px; margin-top: 25px;\">\n    Best regards,<br>\n    <strong>Team ChanaX</strong><br>\n    <a href=\"https://chanax.in\" style=\"color: #2563eb; text-decoration: none;\">\n      chanaX.in\n    </a>\n  </p>\n\n  <p style=\"font-size: 12px; color: #888888; margin-top: 30px;\">\n    You received this because {{ $json.business_name ? $json.business_name + ' was' : 'your business was' }} recently registered in India.\n    Don't want these emails? Reply with \"unsubscribe\" and we'll stop.\n  </p>\n\n</div>",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "fbe5d77b-e2dc-4583-9890-cbce8c92f3c7",
      "name": "Send via Gmail",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        144,
        96
      ],
      "webhookId": "aa0498d6-9d6c-46ea-a546-454fdecf0345",
      "credentials": {
        "gmailOAuth2": {
          "id": "TvWfN4k10RnfLcWg",
          "name": "campaigns@info.chanax.in"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "operation": "update",
        "tableId": "breezy_marketing_leads",
        "filters": {
          "conditions": [
            {
              "keyName": "id",
              "condition": "eq",
              "keyValue": "={{ $('Prepare email').item.json.id }}"
            }
          ]
        },
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "status",
              "fieldValue": "sent"
            },
            {
              "fieldId": "sent_at",
              "fieldValue": "={{ $now.toISO() }}"
            },
            {
              "fieldId": "attempts",
              "fieldValue": "1"
            },
            {
              "fieldId": "updated_at",
              "fieldValue": "={{ $now.toISO() }}"
            }
          ]
        }
      },
      "id": "42bf49be-d32e-4625-a5c0-071956c9d09d",
      "name": "Mark as sent",
