{
  "name": "ChanaX Outreach Emails",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "=0 9 * * 1-5"
            }
          ]
        }
      },
      "id": "ee809865-f18d-427e-a099-681d944b890f",
      "name": "Schedule Daily 9AM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -576,
        96
      ]
    },
    {
      "parameters": {
        "operation": "getAll",
        "tableId": "breezy_marketing_leads",
        "limit": 200,
        "filters": {
          "conditions": [
            {
              "keyName": "status",
              "condition": "eq",
              "keyValue": "pending"
            }
          ]
        }
      },
      "id": "3505f0fd-ea8a-453a-bbdf-50b3062c4e4a",
      "name": "Get pending leads",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        -320,
        96
      ],
      "credentials": {
        "supabaseApi": {
          "id": "IdZNGGvWxsQGnxyf",
          "name": "Supabase account"
        }
      },
      "alwaysOutputData": false
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "9e45e435-45d2-4dc9-baae-148d66f17b52",
              "name": "id",
              "value": "={{ $json.id }}",
              "type": "string"
            },
            {
              "id": "e70cb279-632c-4ee8-a43b-a35871f28806",
              "name": "email",
              "value": "={{ $json.email }}",
              "type": "string"
            },
            {
              "id": "8971e13c-d018-4874-8fb5-ecb69c3e65c2",
              "name": "name",
              "value": "={{ $json.contact_name || $json.business_name || 'there' }}",
              "type": "string"
            },
            {
              "id": "848936e8-eb8a-4b68-987c-be93b3fc7276",
              "name": "business_name",
              "value": "={{ $json.business_name || '' }}",
              "type": "string"
            },
            {
              "id": "8adca5ef-cdbf-497d-9fe4-d04682f4a31f",
              "name": "source",
              "value": "={{ $json.source }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "cc565ef6-445a-4932-b452-0b59882ce1cb",
      "name": "Prepare email",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -96,
        96
